@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix task: <https://locorda.dev/example/minimal/vocabulary/task#> .
@prefix algo: <https://w3id.org/solid-crdt-sync/vocab/crdt-algorithms#> .
@prefix mc: <https://w3id.org/solid-crdt-sync/vocab/merge-contract#> .
@prefix mappings: <https://w3id.org/solid-crdt-sync/mappings/> .

# Task merge contract mapping file for minimal task app
<> a mc:DocumentMapping;
   rdfs:label "Task Merge Contract v1" ;
   # Import standard CRDT framework mappings
   mc:imports ( mappings:core-v1 ) ;
   # Define task-specific class mappings
   mc:classMapping ( <#task> ) .

<#task> a mc:ClassMapping;
   mc:appliesToClass task:Task;
   mc:rule
     [ mc:predicate schema:name; algo:mergeWith algo:LWW_Register ],
     [ mc:predicate task:completed; algo:mergeWith algo:LWW_Register ],
     [ mc:predicate schema:dateCreated; algo:mergeWith algo:Immutable ] .
